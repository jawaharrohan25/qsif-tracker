rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own portfolio document.
    // Replace YOUR_GMAIL_ADDRESS with the Google account you sign in with, so nobody else can even create data here.
    match /portfolios/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'jawaharrohan@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

   window.QSIF_FIREBASE = {
     apiKey: "…copy from the box…",
     authDomain: "qsif-tracker.firebaseapp.com",
     projectId: "qsif-tracker",
     appId: "…copy from the box…"
   };