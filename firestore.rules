rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google accounts can read and write the shared portfolio.
    // To add or remove a person, edit this list and publish.
    match /portfolios/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['jawaharrohan@gmail.com', 'OTHER_PERSON@gmail.com']
        && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
